generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
}


// *****************************
// Temel tablolar
// *****************************

// Admin sayfası vesaire eklersek diye rol enum'u
enum Role {
  ADMIN
  USER
}

// Kullanıcı modeli
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  role          Role      @default(USER)
  
  totalPoints   Int       @default(0)
  level         Int       @default(1)
  
  // İlişkiler
  submissions   Submission[]
  solvedProblems SolvedProblem[]
  threads       Thread[]
  comments      Comment[]
  achievements  UserAchievement[]

  accounts      Account[]
  sessions      Session[]
}

// Bu tablo ile işiniz yok
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}
// Bu tablo ile işiniz yok
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ***************************
// Kodlama sistemi
// ***************************

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// Gönderimin durumu. PENDING ve RUNNING judge'ın kuyruğu, diğerleri sonuç (verdict).
enum SubStatus {
  PENDING          // sırada bekliyor
  RUNNING          // judge şu an çalıştırıyor
  ACCEPTED         // tüm testler geçti
  WRONG_ANSWER     // yanlış sonuç
  TIME_LIMIT       // süre aşıldı
  MEMORY_LIMIT     // bellek aşıldı
  RUNTIME_ERROR    // çalışırken hata (ör. dizi dışı erişim)
  COMPILE_ERROR    // kod derlenemedi / sözdizimi hatası
  INTERNAL_ERROR   // bizim taraftaki hata (Docker kapalı vb.)
}

// "Çalıştır" (sadece görünür testler, puan yok) ve "Gönder" (tüm testler)
enum SubmissionKind {
  RUN
  SUBMIT
}

enum Language {
  CPP
  JAVA
  PYTHON
}

// Soru modeli
model Problem {
  id            String       @id @default(cuid())
  title         String
  description   String
  difficulty    Difficulty
  category      String       // Başlıklara ayırmak için. Diziler, döngüler gibi 
  starterCode   String       // Leetcode'da Solition class'ı oluyordu soruları açınca. Bu o ilk kodu
  pointsAwarded Int          // Çözülünce verilecek puan
  
  testCases     TestCase[]   // Leetcode'daki soruların altında 2-3 tane olan örnek testler
  submissions   Submission[]
  solvedBy      SolvedProblem[]

  @@map("Puzzle")
}
// Sorular için testlerin modeli
model TestCase {
  id             String  @id @default(cuid())
  problemId      String  @map("puzzleId")
  problem        Problem @relation(fields: [problemId], references: [id])
  input          String  
  expectedOutput String  
}

// Kullanıcıların yükleyeceği cevapların modeli
model Submission {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  problemId   String    @map("puzzleId")
  problem     Problem   @relation(fields: [problemId], references: [id])
  
  code        String    @db.Text
  language    Language
  kind        SubmissionKind @default(SUBMIT)
  status      SubStatus @default(PENDING)
  passedCount Int       @default(0)
  totalCount  Int       @default(0)
  runtimeMs   Int?                        // geçen testlerdeki en uzun süre
  result      Json?                       // judge'ın detaylı sonucu (JudgeResult tipi)
  createdAt   DateTime  @default(now())
  judgedAt    DateTime?

  solvedBy    SolvedProblem?

  @@index([status, createdAt])                   // judge kuyruğu bu indeksle aranır
  @@index([userId, problemId, createdAt])        // gönderim geçmişi
  @@index([problemId, language, status])         // "%X'inden hızlı" hesabı
}

// Kullanıcının çözdüğü sorular. Her (kullanıcı, soru) çifti en fazla bir kez yazılabildiği için
// puan sadece ilk ACCEPTED gönderimde verilir.
model SolvedProblem {
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  problemId    String     @map("puzzleId")
  problem      Problem    @relation(fields: [problemId], references: [id])
  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id])
  solvedAt     DateTime   @default(now())

  @@id([userId, problemId])
}

// *****************************
// Forum kısmı
// *****************************

// Forumda açılan her başlığın temsili
model Thread {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  views       Int       @default(0)
  isResolved  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  
  comments    Comment[]
}
// Başlık altındaki yorumların modeli
model Comment {
  id               String   @id @default(cuid())
  content          String   @db.Text
  threadId         String
  thread           Thread   @relation(fields: [threadId], references: [id])
  authorId         String
  author           User     @relation(fields: [authorId], references: [id])
  isAcceptedAnswer Boolean  @default(false)
  createdAt        DateTime @default(now())
}

// ********************************
// Başarım sistemi
// ********************************

// Başarımların modeli
model Achievement {
  id          String    @id @default(cuid())
  name        String    
  description String
  icon        String    
  
  users       UserAchievement[]
}

// Kullanıcılarla başarımlar arasında bir Relation (Richard hocam öğretti bunları sağolsun)
model UserAchievement {
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime    @default(now())

  @@id([userId, achievementId]) // 1'e 1 ilişki
}
