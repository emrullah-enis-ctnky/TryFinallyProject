# ==============================================================================
# TryFinally — Çevre Değişkenleri Şablon Dosyası (.env.example)
# ==============================================================================
# Bu dosya, TryFinally projesinin sorunsuz çalışabilmesi için gereken ortam
# değişkenlerini (environment variables) ve açıklamalarını içerir.
#
# 🚀 HIZLI BAŞLANGIÇ:
# 1. Bu dosyayı proje ana dizininde ".env.local" adıyla kopyalayın:
#    cp .env.example .env.local
# 2. Aşağıdaki değişkenleri kendi geliştirme ortamınıza göre doldurun.
# 3. ÖNEMLİ GÜVENLİK NOTU:
#    .env.local dosyası özel API anahtarları ve şifreler içerir.
#    Bu dosya .gitignore listesindedir ve ASLA Git'e gönderilmemelidir!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API Yapılandırması (Zorunlu Tek Harici API Bağımlılığı)
# ------------------------------------------------------------------------------
# TryFinally platformunda yeni başlayanlar için kod hata açıklamaları,
# akıllı çözüm ipuçları (hints) ve forum asistanlığı Google Gemini API ile yapılır.
# Projemizin harici hiçbir ücretli veya üçüncü parti API bağımlılığı yoktur.
# 
# Ücretsiz Gemini API anahtarınızı buradan alabilirsiniz:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=buraya_gemini_api_anahtarinizi_yazin

# Kullanılacak Gemini Model Adı (Varsayılan: gemini-3.8-flash)
# Hızlı yanıt süreleri ve yüksek muhakeme kabiliyeti için gemini-3.8-flash kullanılır.
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 2. Sunucu Veritabanı Yapılandırması (Server Database)
# ------------------------------------------------------------------------------
# TryFinally, tüm verilerin sunucu tarafında güvenle saklandığı sunucu odaklı
# (server-centric) bir mimariye sahiptir.
#
# Geliştirme ortamında pratik kullanım için SQLite örneği:
# DATABASE_URL="file:./dev.db"
#
# Docker veya yerel PostgreSQL kullanıyorsanız örnek:
# DATABASE_URL="postgresql://kullanici:sifre@localhost:5432/tryfinally?schema=public"
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 3. Uygulama ve Sunucu Ortam Ayarları
# ------------------------------------------------------------------------------
# Çalışma ortamı türü ('development', 'production', 'test')
NODE_ENV=development

# Web uygulamasının çalıştığı ana adres (tarayıcıdan erişim)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Merkezi Loglama Yapılandırması (@/lib/logger)
# ------------------------------------------------------------------------------
# Konsola ve log servisine yazılacak en düşük log seviyesi.
# Seçenekler: 'debug', 'info', 'warn', 'error'
# Geliştirme (development) ortamında 'debug', canlıda (production) 'info' önerilir.
NEXT_PUBLIC_LOG_LEVEL=debug
